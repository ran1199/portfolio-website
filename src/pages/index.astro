---
// Home page: intro line, then a gallery mixing the case studies (large,
// clickable) with selected visual pieces (smaller, just for looking).
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import VisualPiece from "../components/VisualPiece.astro";

const site = (await getEntry("site", "site"))!.data;
const studies = (await getCollection("caseStudies")).sort((a, b) => a.data.order - b.data.order);

// Visual pieces marked "home: true" in content/play.yaml. Until there
// are any, grey placeholders stand in (one next to each case study).
const homePieces = (await getCollection("play")).filter((p) => p.data.home);
const pieces = homePieces.length ? homePieces : studies.map(() => undefined);

// Each row pairs one case study with one visual piece, alternating sides.
// Any extra pieces go in a row of small tiles at the end.
const rows = studies.map((study, i) => ({ study, piece: pieces[i] }));
const extras = homePieces.slice(studies.length);
const placeholderShapes = ["4 / 5", "1 / 1", "3 / 4", "4 / 5"];
const pieceSizes = "(min-width: 48rem) 30vw, 62vw";
---

<BaseLayout>
  <section class="container intro">
    <h1>{site.introLine}</h1>
  </section>

  <section id="work" class="container gallery" aria-labelledby="work-heading">
    <h2 id="work-heading" class="visually-hidden">{site.menu.work}</h2>

    {
      rows.map(({ study, piece }, i) => (
        <div class:list={["row", { "row--flip": i % 2 === 1 }]}>
          <div class="row__case reveal">
            <CaseStudyCard study={study} priority={i === 0} />
          </div>
          {(piece || !homePieces.length) && (
            <div class="row__piece reveal">
              <VisualPiece piece={piece} sizes={pieceSizes} ratio={placeholderShapes[i % 4]} />
            </div>
          )}
        </div>
      ))
    }

    {
      extras.length > 0 && (
        <div class="extras">
          {extras.map((piece) => (
            <div class="reveal">
              <VisualPiece piece={piece} sizes="(min-width: 48rem) 30vw, 45vw" />
            </div>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: var(--space-9) var(--space-8);
  }

  .intro h1 {
    max-width: 22em;
    font-size: var(--text-2xl);
    font-weight: var(--weight-regular);
  }

  .gallery {
    display: grid;
    gap: var(--space-9);
  }

  /* Phones: one column. Case studies full width; visual pieces smaller,
     alternating left and right, so size carries the emphasis. */
  .row {
    display: grid;
    gap: var(--space-8);
  }

  .row__piece {
    width: 62%;
    justify-self: end;
  }

  .row--flip .row__piece {
    justify-self: start;
  }

  .extras {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }

  /* Tablets and up: case study takes 7 of 12 columns, the visual piece 4. */
  @media (min-width: 48rem) {
    .gallery {
      gap: var(--space-10);
    }

    .row {
      grid-template-columns: repeat(12, 1fr);
      column-gap: var(--space-5);
      align-items: end;
    }

    .row__case {
      grid-column: 1 / span 7;
      grid-row: 1;
    }

    .row__piece {
      grid-column: 9 / span 4;
      grid-row: 1;
      width: auto;
    }

    .row--flip .row__case {
      grid-column: 6 / span 7;
    }

    .row--flip .row__piece {
      grid-column: 1 / span 4;
      align-self: start;
    }

    .extras {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-7) var(--space-5);
    }
  }
</style>
