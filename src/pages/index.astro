---
// Home page: a quiet intro line, then the gallery (see WorkGallery.astro).
// The intro line lives in content/site.yaml; leave it empty ("") to hide it.
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkGallery from "../components/WorkGallery.astro";

const site = (await getEntry("site", "site"))!.data;
---

<BaseLayout>
  {
    site.introLine ? (
      <div class="container intro">
        <h1>{site.introLine}</h1>
      </div>
    ) : (
      <h1 class="visually-hidden">{site.name}</h1>
    )
  }

  <section class:list={["home-gallery", { "home-gallery--top": !site.introLine }]} aria-labelledby="work-heading">
    <h2 id="work-heading" class="visually-hidden">{site.menu.work}</h2>
    <WorkGallery />
  </section>
</BaseLayout>

<style>
  /* One quiet line in body size, just under the menu. */
  .intro {
    padding-bottom: var(--space-5);
  }

  .intro h1 {
    font-size: var(--text-base);
    font-weight: var(--weight-regular);
    line-height: var(--leading-normal);
  }

  .home-gallery {
    padding-bottom: var(--grid-edge);
  }

  /* No intro line: same small gap under the menu as the Work page. */
  .home-gallery--top {
    padding-top: var(--space-5);
  }
</style>
