---
// Play page: every visual piece from content/play.yaml, in file order, in
// the same column layout as the Home/Work gallery. Each tile takes the
// shape of its image or video (nothing is cropped). A piece is a link only
// if it has a "link". Grey placeholders fill the grid up to 8 tiles.
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkGallery from "../components/WorkGallery.astro";

const site = (await getEntry("site", "site"))!.data;
---

<BaseLayout title={site.menu.play}>
  <div class="play">
    <!-- Hidden title: not shown on screen, but screen readers still
         announce the page name. -->
    <h1 class="visually-hidden">{site.menu.play}</h1>
    <WorkGallery source="play" />
  </div>
</BaseLayout>

<style>
  /* Same small gap under the menu as the Work page. */
  .play {
    padding-block: var(--space-5) var(--grid-edge);
  }
</style>
