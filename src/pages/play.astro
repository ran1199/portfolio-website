---
// Play page. The grid of visual work is built in Phase 5.
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const site = (await getEntry("site", "site"))!.data;
---

<BaseLayout title={site.menu.play}>
  <section class="container page">
    <h1>{site.menu.play}</h1>
    <p class="placeholder">[PLACEHOLDER: Grid of visual work — built in Phase 5]</p>
  </section>
</BaseLayout>

<style>
  .page {
    padding-top: var(--space-9);
  }
  h1 {
    font-size: var(--text-2xl);
    font-weight: var(--weight-regular);
    margin-bottom: var(--space-7);
  }
  .placeholder {
    padding: var(--space-9) var(--space-5);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-align: center;
  }
</style>
