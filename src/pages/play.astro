---
// Play page: every visual piece from content/play.yaml, in file order.
// Just for looking — pieces are never links. Until there are any,
// grey placeholders stand in.
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import VisualPiece from "../components/VisualPiece.astro";

const site = (await getEntry("site", "site"))!.data;
const pieces = await getCollection("play");
const PLACEHOLDER_COUNT = 9;
const items = pieces.length ? pieces : Array.from({ length: PLACEHOLDER_COUNT }, () => undefined);
---

<BaseLayout title={site.menu.play}>
  <div class="container play">
    <!-- Hidden title: not shown on screen, but screen readers still
         announce the page name. -->
    <h1 class="visually-hidden">{site.menu.play}</h1>
    <ul class="play__grid">
      {
        items.map((piece) => (
          <li class="play__item reveal">
            <VisualPiece piece={piece} fit="contain" sizes="(min-width: 64rem) 30vw, 48vw" />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  /* Small gap under the menu so the grid starts near the top. */
  .play {
    padding-top: var(--space-5);
  }

  /* Square tiles: two across on phones and tablets, three on wide screens. */
  .play__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gallery-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .play__item {
    aspect-ratio: 1 / 1;
  }

  @media (min-width: 64rem) {
    .play__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
