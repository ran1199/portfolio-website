---
// TEMPORARY page for Phase 2: compares three font options side by side
// using Ran's real content. Deleted once a font is chosen.
import { getCollection, getEntry } from "astro:content";
// Font files are stored inside the project (no Google servers needed).
import "@fontsource-variable/inter";
import "@fontsource-variable/instrument-sans";
import "@fontsource-variable/dm-sans";

const site = (await getEntry("site", "site"))!.data;
const studies = (await getCollection("caseStudies")).sort(
  (a, b) => a.data.order - b.data.order,
);
const gg = studies[0].data;
const timeline = (await getEntry("about", "about"))!.data.timeline.slice(0, 3);

const fonts = [
  {
    letter: "A",
    name: "Inter",
    note: "Neutral and extremely readable. Designed for screens; the safest, most \"invisible\" choice.",
    family: "'Inter Variable', sans-serif",
  },
  {
    letter: "B",
    name: "Instrument Sans",
    note: "Crisp and slightly narrow, with a fashion-brand feel. Closest to the Skims / Alo Yoga look.",
    family: "'Instrument Sans Variable', sans-serif",
  },
  {
    letter: "C",
    name: "DM Sans",
    note: "Rounder and softer, with a gentle, friendly tone. Feels the calmest of the three.",
    family: "'DM Sans Variable', sans-serif",
  },
];

// Real text from the brief (Galactic Guardians testing → change).
const bodyText =
  "Testers found manual entry slow. With 4 players, counting resources and scores made mistakes easy. I added photo capture to the New Game Record page, so the app detects results automatically.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Font options — {site.name}</title>
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: #fff;
        color: #111;
        font-family: system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .intro {
        max-width: 72rem;
        margin: 0 auto;
        padding: 48px 24px 8px;
        color: #555;
        font-size: 15px;
        line-height: 1.6;
      }
      .intro h1 { color: #111; font-size: 15px; font-weight: 600; margin: 0 0 4px; }
      .intro p { margin: 0; }
      .grid {
        max-width: 72rem;
        margin: 0 auto;
        padding: 24px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 48px;
      }
      @media (max-width: 900px) {
        .grid { grid-template-columns: 1fr; gap: 72px; }
      }
      .option { border-top: 1px solid #111; padding-top: 16px; }
      .label {
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 13px;
        color: #777;
        margin: 0 0 40px;
        line-height: 1.5;
      }
      .label strong { color: #111; font-weight: 600; font-size: 15px; display: block; }

      /* Everything inside .sample uses the font being compared. */
      .sample { line-height: 1.6; }
      .menu {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 12px;
        font-size: 14px;
        margin-bottom: 48px;
      }
      .menu span:first-child { font-weight: 500; }
      .menu .links { display: flex; gap: 16px; color: #444; }
      .hero { font-size: 26px; line-height: 1.3; font-weight: 400; margin: 0 0 48px; letter-spacing: -0.01em; }
      .eyebrow { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: #666; margin: 0 0 8px; }
      h2 { font-size: 20px; font-weight: 500; margin: 0 0 8px; letter-spacing: -0.005em; }
      .summary { font-size: 15px; color: #444; margin: 0 0 12px; }
      .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 32px; padding: 0; list-style: none; }
      .tags li { font-size: 12px; border: 1px solid #ddd; border-radius: 999px; padding: 2px 10px; color: #444; }
      .body { font-size: 17px; margin: 0 0 40px; }
      .timeline { list-style: none; margin: 0; padding: 0; font-size: 14px; }
      .timeline li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 12px; padding: 12px 0; border-top: 1px solid #eee; }
      .timeline .when { color: #777; }
      .timeline .role { color: #555; }
      .digits { font-size: 14px; color: #777; margin-top: 32px; }
    </style>
  </head>
  <body>
    <header class="intro">
      <h1>Font options — Phase 2</h1>
      <p>The same real text in three fonts. Only the font changes; sizes, spacing and colors are the same. On a phone, scroll down to see all three.</p>
    </header>
    <main class="grid">
      {
        fonts.map((f) => (
          <section class="option" aria-label={`Option ${f.letter}: ${f.name}`}>
            <p class="label">
              <strong>
                {f.letter} — {f.name}
              </strong>
              {f.note}
            </p>
            <div class="sample" style={`font-family: ${f.family}`}>
              <div class="menu">
                <span>{site.name}</span>
                <span class="links">
                  <span>{site.menu.work}</span>
                  <span>{site.menu.play}</span>
                  <span>{site.menu.about}</span>
                  <span>{site.menu.resume}</span>
                </span>
              </div>
              <p class="hero">{site.introLine}</p>
              <p class="eyebrow">Case study · {gg.dates}</p>
              <h2>{gg.title}</h2>
              <p class="summary">{gg.summary}</p>
              <ul class="tags">
                {gg.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
              <p class="body">{bodyText}</p>
              <ul class="timeline">
                {timeline.map((t) => (
                  <li>
                    <span class="when">{t.when}</span>
                    <span>
                      {t.where}
                      <br />
                      <span class="role">{t.role}</span>
                    </span>
                  </li>
                ))}
              </ul>
              <p class="digits">0123456789 · Résumé · “Quotes” — &amp; ?!</p>
            </div>
          </section>
        ))
      }
    </main>
  </body>
</html>
