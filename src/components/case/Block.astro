---
// One "block" of a visual-first case study section (see _TEMPLATE.md).
// Images lead; text stays short and supports them. A block normally
// uses one kind of content; when a block has an image AND insight/text,
// the image takes the wider column with the text beside it.
import type { CollectionEntry } from "astro:content";
import Inline from "./Inline.astro";
import Text from "./Text.astro";
import Media from "./Media.astro";
import Video from "./Video.astro";
import { findImage } from "../../lib/media";

type Study = CollectionEntry<"caseStudies">["data"];
type BlockData = NonNullable<Study["sections"]>[number]["blocks"][number];

interface Props {
  block: BlockData;
  folder: string;
  labels: Record<string, string>;
}

const { block: b, folder, labels } = Astro.props;
const hasImage = b.image !== undefined;
const hasSideText = Boolean(b.insight || b.goal || b.text);
const sideBySide = hasImage && hasSideText && b.size !== "small";
// Insight can be one line or a list of short lines.
const insightLines = b.insight === undefined ? [] : [b.insight].flat();
// Landscape photos in before/after use the panel's full width;
// tall phone screens stay narrower.
const isLandscape = (image?: string) => {
  if (!image) return false;
  const meta = findImage(folder, image);
  return meta.width > meta.height;
};
---

<div class:list={["block", { "block--side": sideBySide }]}>
  {/* Optional small heading above the block, e.g. "Design focus" */}
  {
    b.label && (
      <p class="small-label block__label">
        <Inline text={b.label} />
      </p>
    )
  }

  {/* Big typographic moment, e.g. a campaign's key message */}
  {
    b.statement && (
      <p class="statement">
        <Inline text={b.statement} />
      </p>
    )
  }

  {
    hasImage && (
      <div class:list={["block__image", { "block__image--small": b.size === "small" }]}>
        <Media
          folder={folder}
          image={b.image}
          alt={b.alt}
          caption={b.caption}
          sizes={b.size === "small" ? "(min-width: 64rem) 40vw, 100vw" : sideBySide ? "(min-width: 64rem) 60vw, 100vw" : "(min-width: 90rem) 86rem, 100vw"}
        />
      </div>
    )
  }

  {
    hasSideText && (
      <div class="block__side">
        {b.text && <Text text={b.text} />}
        {b.source && (
          <p class="block__source">
            {labels.source}: <Inline text={b.source} />
          </p>
        )}
        {insightLines.length > 0 && (
          <div>
            <p class="small-label">{labels.insightLabel}</p>
            {insightLines.map((line) => (
              <p class="block__statement">
                <Inline text={line} />
              </p>
            ))}
          </div>
        )}
        {b.goal && (
          <div>
            <p class="small-label">{labels.goalLabel}</p>
            <p class="block__statement">
              <Inline text={b.goal} />
            </p>
          </div>
        )}
      </div>
    )
  }

  {/* Pull quotes, credited without names or photos */}
  {
    b.quotes && (
      <div class="quotes">
        {b.quotes.map((q) => (
          <figure class="quote">
            <blockquote>
              <p>
                “<Inline text={q.text} />”
              </p>
            </blockquote>
            <figcaption>
              — <Inline text={q.credit} />
            </figcaption>
          </figure>
        ))}
      </div>
    )
  }

  {/* Small text cards: a title and one line each */}
  {
    b.tiles && (
      <ul class="tiles">
        {b.tiles.map((t) => (
          <li class="tile">
            <p class="tile__title">
              <Inline text={t.title} />
            </p>
            {t.text && (
              <p class="tile__text">
                <Inline text={t.text} />
              </p>
            )}
          </li>
        ))}
      </ul>
    )
  }

  {/* Cards: a title, an image, then one line */}
  {
    b.cards && (
      <ul class="cards">
        {b.cards.map((c) => (
          <li class="cards__item">
            <p class="cards__title">
              <Inline text={c.title} />
            </p>
            <Media folder={folder} image={c.image} alt={c.alt} sizes="(min-width: 64rem) 28vw, (min-width: 40rem) 45vw, 100vw" />
            {c.text && (
              <p class="cards__text">
                <Inline text={c.text} />
              </p>
            )}
          </li>
        ))}
      </ul>
    )
  }

  {/* Gallery: first image large, the rest side by side.
      With sideBySide: true, all images share one row at equal size. */}
  {
    b.gallery && (
      <div class:list={["gallery", { "gallery--row": b.sideBySide }]}>
        {b.gallery.map((g, i) => {
          const lead = i === 0 && !b.sideBySide;
          return (
            <div class:list={["gallery__item", { "gallery__item--lead": lead }]}>
              <Media folder={folder} image={g.image} alt={g.alt} caption={g.caption} sizes={lead ? "(min-width: 90rem) 86rem, 100vw" : "(min-width: 48rem) 45vw, 100vw"} />
            </div>
          );
        })}
      </div>
    )
  }
  {
    b.gallery && b.caption && !hasImage && (
      <p class="block__caption">
        <Inline text={b.caption} />
      </p>
    )
  }

  {/* Photo steps: a row on wide screens, stacked on phones */}
  {
    b.steps && (
      <ol class="steps">
        {b.steps.map((step, i) => (
          <li class="steps__item">
            <Media folder={folder} image={step.image} alt={step.alt} sizes="(min-width: 64rem) 18vw, (min-width: 40rem) 45vw, 100vw" />
            <p class="steps__number">{String(i + 1).padStart(2, "0")}</p>
            <p class="steps__title">
              <Inline text={step.title} />
            </p>
            {step.text && (
              <p class="steps__text">
                <Inline text={step.text} />
              </p>
            )}
          </li>
        ))}
      </ol>
    )
  }

  {/* App screens: label above, caption below. One row on wide screens,
      2 per row on tablets, swipeable on phones. The images already
      include the phone frame, so no border is added. */}
  {
    b.screens && (
      <ul class="screens">
        {b.screens.map((s) => (
          <li class="screens__item">
            {s.title && (
              <p class="screens__title">
                <Inline text={s.title} />
              </p>
            )}
            <Media folder={folder} image={s.image} alt={s.alt} placeholderRatio="9 / 19.5" sizes="(min-width: 40rem) 230px, 62vw" />
            {s.caption && (
              <p class="screens__caption">
                <Inline text={s.caption} />
              </p>
            )}
          </li>
        ))}
      </ul>
    )
  }

  {/* Before / after */}
  {
    (b.before || b.after) && (
      <div class="ba">
        {(["before", "after"] as const).map((key) => {
          const side = b[key];
          return side ? (
            <div class:list={["ba__side", `ba__side--${key}`]}>
              <p class:list={["pill", { "pill--solid": key === "after" }]}>{labels[key]}</p>
              <p class="ba__text">
                <Inline text={side.text} />
              </p>
              <div class:list={["ba__panel", { "ba__panel--wide": isLandscape(side.image) }]}>
                <Media folder={folder} image={side.image} alt={side.alt} placeholderRatio="9 / 19.5" sizes="(min-width: 48rem) 40vw, 100vw" />
              </div>
            </div>
          ) : null;
        })}
      </div>
    )
  }

  {b.video && <div class="block__video"><Video folder={folder} {...b.video} /></div>}

  {
    b.note && (
      <p class="block__note">
        <Inline text={b.note} />
      </p>
    )
  }
</div>

<style>
  .block {
    display: grid;
    gap: var(--space-6);
    min-width: 0;
  }

  .small-label {
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .block__label {
    margin-bottom: calc(-1 * var(--space-3));
  }

  .block--side .block__label {
    grid-column: 1 / -1;
  }

  .block__side {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }

  .block__statement {
    max-width: 40rem;
    font-size: var(--text-lg);
    line-height: 1.4;
  }

  .block__statement + .block__statement {
    margin-top: var(--space-2);
  }

  .block__caption {
    margin-top: calc(-1 * var(--space-3));
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .block__source,
  .block__note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .block__image--small {
    max-width: 32rem;
  }

  .block__video {
    max-width: 56rem;
  }

  /* Image beside text: image 8 of 12 columns, text 4. */
  @media (min-width: 64rem) {
    .block--side {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: center;
    }
  }

  /* ── Statement ── */
  .statement {
    max-width: 20ch;
    padding-block: var(--space-7);
    font-size: clamp(2rem, 1.2rem + 3.6vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  /* ── Pull quotes ── */
  .quotes {
    display: grid;
    gap: var(--space-8) var(--space-7);
  }

  .quote {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    margin: 0;
  }

  .quote blockquote {
    margin: 0;
    font-size: var(--text-xl);
    line-height: 1.35;
    letter-spacing: var(--tracking-tight);
  }

  .quote figcaption {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* ── Text tiles ── */
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-6);
    border-radius: var(--radius-media);
    background: var(--color-surface);
  }

  .tile__title {
    font-weight: var(--weight-medium);
  }

  .tile__text {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* ── Cards ── */
  .cards {
    display: grid;
    gap: var(--space-7) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cards__item {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .cards__title {
    font-weight: var(--weight-medium);
  }

  .cards__text {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* ── Gallery ── */
  .gallery {
    display: grid;
    gap: var(--space-7) var(--space-5);
  }

  /* ── Steps ── */
  .steps {
    display: grid;
    gap: var(--space-7) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps__item {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .steps__number {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .steps__title {
    font-weight: var(--weight-medium);
  }

  .steps__text {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* ── Screens: swipe sideways on phones (the next screen peeks in) ── */
  .screens {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(62%, var(--screen-max));
    gap: var(--space-7) var(--space-5);
    margin: 0;
    padding: 0 0 var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    list-style: none;
    /* Screens are 454px files: shown at most 230px wide to stay sharp. */
    --screen-max: 14.375rem;
  }

  .screens__item {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    justify-items: center;
    text-align: center;
    scroll-snap-align: start;
  }

  .screens__item :global(.media) {
    width: 100%;
    max-width: var(--screen-max);
  }

  .screens__title {
    font-weight: var(--weight-medium);
  }

  .screens__caption {
    max-width: 18rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* The phone frame is part of the image: no border or rounding. */
  .screens :global(img) {
    border-radius: 0;
  }

  /* ── Before / after ── */
  .ba {
    display: grid;
    gap: var(--space-7);
  }

  .ba__side {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .pill {
    justify-self: start;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-text);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
  }

  .pill--solid {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .ba__text {
    max-width: 30rem;
  }

  .ba__panel {
    display: grid;
    place-items: center;
    padding: var(--space-6);
    border-radius: var(--radius-media);
    background: var(--color-surface);
  }

  /* Tall screenshots stay a comfortable height inside the panel. */
  .ba__panel :global(.media) {
    width: min(100%, 20rem);
  }

  .ba__panel--wide :global(.media) {
    width: 100%;
  }

  .ba__panel :global(.media__placeholder) {
    background: var(--color-bg);
  }

  @media (min-width: 40rem) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }

    .steps {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Tablets: 2 screens per row. */
    .screens {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-bottom: 0;
      overflow: visible;
    }
  }

  @media (min-width: 48rem) {
    .gallery {
      grid-template-columns: 1fr 1fr;
    }

    .gallery__item--lead,
    .gallery__item--lead + .gallery__item:last-child {
      grid-column: 1 / -1;
    }

    /* Side-by-side row: as many equal columns as there are images. */
    .gallery--row {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }

    .ba {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }

    .quotes {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 64rem) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }

    /* All steps in one row, however many there are. */
    .steps {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }

    /* All screens in one evenly spaced row. */
    .screens {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }
  }
</style>
