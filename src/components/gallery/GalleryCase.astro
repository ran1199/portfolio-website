---
// A case study in the gallery. The whole tile is one link, with the
// "View" cursor on laptops. With a mouse or trackpad, the title, summary
// and "View case study →" fade in over the bottom of the image; on
// phones and tablets the title and summary are always shown under it.
// A case study with "published: false" shows the same tile, but it isn't
// a link and says "Coming soon" instead.
import type { CollectionEntry } from "astro:content";
import GalleryTile from "./GalleryTile.astro";
import type { GalleryMedia } from "../../lib/gallery";
import { withBase } from "../../lib/url";

interface Props {
  study: CollectionEntry<"caseStudies">;
  media: GalleryMedia;
  alt: string;
  fit: "cover" | "contain";
  priority?: boolean;
}

const { study, media, alt, fit, priority = false } = Astro.props;
const { title, summary, published } = study.data;
const Tag = published ? "a" : "div";
---

<article class:list={["g-case reveal", { "g-case--soon": !published }]}>
  <Tag
    class="g-case__link"
    href={published ? withBase(`work/${study.id}/`) : undefined}
    data-cursor={published ? "view" : undefined}
  >
    <GalleryTile
      media={media}
      alt={alt}
      fit={fit}
      sizes="(min-width: 40rem) 50vw, 100vw"
      priority={priority}
      class="g-case__tile"
    />
    <div class="g-case__text">
      <h3 class="g-case__title">{title}</h3>
      <p class="g-case__summary">{summary}</p>
      {
        published ? (
          <span class="g-case__cta">View case study <span aria-hidden="true">→</span></span>
        ) : (
          <span class="g-case__cta g-case__cta--soon">Coming soon</span>
        )
      }
    </div>
  </Tag>
</article>
