---
// Footer shown on every page: email, copy button and résumé link.
import { getEntry } from "astro:content";
import { withBase } from "../lib/url";
import CopyEmail from "./CopyEmail.astro";

const site = (await getEntry("site", "site"))!.data;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__contact">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <CopyEmail email={site.email} label="Copy" />
    </div>
    <a href={withBase("resume.pdf")}>{site.menu.resume}</a>
    <p class="site-footer__copyright">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-10);
    border-top: 1px solid var(--color-line);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-7);
    padding-block: var(--space-7);
    font-size: var(--text-sm);
  }

  .site-footer__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .site-footer__copyright {
    margin-left: auto;
    color: var(--color-text-muted);
  }

  @media (max-width: 40rem) {
    .site-footer__inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .site-footer__copyright {
      margin-left: 0;
    }
  }
</style>
