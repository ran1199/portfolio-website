---
// Top menu shown on every page.
import { getEntry } from "astro:content";
import { withBase } from "../lib/url";
import CopyEmail from "./CopyEmail.astro";

const site = (await getEntry("site", "site"))!.data;
const path = Astro.url.pathname.replace(/\/$/, "");
const isCurrent = (href: string) => path === href.replace(/\/$/, "");

const links = [
  { label: site.menu.work, href: withBase("#work") },
  { label: site.menu.play, href: withBase("play/") },
  { label: site.menu.about, href: withBase("about/") },
  { label: site.menu.resume, href: withBase("resume.pdf") },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__name" href={withBase()}>{site.name}</a>
    <nav aria-label="Main">
      <ul class="site-header__links">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li><CopyEmail email={site.email} /></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-5);
    font-size: var(--text-sm);
  }

  .site-header__name {
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .site-header__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__links a {
    text-decoration: none;
  }

  .site-header__links a:hover,
  .site-header__links a[aria-current="page"] {
    text-decoration: underline;
  }

  /* Phones: name on the first row, menu on the second. */
  @media (max-width: 40rem) {
    .site-header__inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .site-header__links {
      gap: var(--space-2) var(--space-4);
    }
  }
</style>
