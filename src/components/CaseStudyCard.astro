---
// A case study in the Home gallery. The whole card is one link.
// On laptops (mouse or trackpad) the title and summary fade in on hover.
// On phones and tablets they are always shown under the image.
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { findImage } from "../lib/media";
import { withBase } from "../lib/url";

interface Props {
  study: CollectionEntry<"caseStudies">;
  priority?: boolean; // true for the first card, so it loads first
}

const { study, priority = false } = Astro.props;
const { title, summary, cover, coverAlt } = study.data;
const coverImage = cover ? findImage(study.id, cover) : undefined;
---

<article class="case">
  <a class="case__link" href={withBase(`work/${study.id}/`)} data-cursor="view">
    <div class="case__media">
      {
        coverImage ? (
          <Image
            src={coverImage}
            alt={coverAlt}
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 48rem) 58vw, 100vw"
            priority={priority}
          />
        ) : (
          <div class="case__placeholder">[PLACEHOLDER: cover image]</div>
        )
      }
    </div>
    <div class="case__caption">
      <h3 class="case__title">{title}</h3>
      <p class="case__summary">{summary}</p>
      <span class="case__cta">View case study <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>

<style>
  /* The card fills whatever space the gallery gives it. */
  .case,
  .case__link {
    height: 100%;
  }

  .case__link {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .case__link:hover {
    color: inherit;
  }

  .case__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--color-surface);
  }

  .case__media img,
  .case__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case__placeholder {
    display: grid;
    place-items: center;
    padding: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  .case__caption {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
  }

  .case__title {
    font-size: var(--text-lg);
  }

  .case__summary {
    max-width: 34rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .case__cta {
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  /* Wide screens: the image fills the whole tile and the details sit
     on a white panel in the bottom-left corner of the image. */
  @media (min-width: 64rem) {
    .case__media {
      flex: 1;
      aspect-ratio: auto;
    }

    .case__caption {
      position: absolute;
      left: var(--space-4);
      bottom: var(--space-4);
      max-width: min(30rem, calc(100% - 2 * var(--space-4)));
      padding: var(--space-4) var(--space-5);
      border-radius: var(--radius-media);
      background: var(--color-bg);
    }
  }

  /* Wide screens with a mouse or trackpad: the panel fades in on hover
     (or when the card is reached with the Tab key). On touch screens
     it stays visible. */
  @media (min-width: 64rem) and (hover: hover) and (pointer: fine) {
    .case__caption {
      opacity: 0;
      transition: opacity var(--duration-slow) var(--ease);
    }

    .case__link:hover .case__caption,
    .case__link:focus-visible .case__caption {
      opacity: 1;
    }
  }
</style>
