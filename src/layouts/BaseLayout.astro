---
// The frame around every page: page info for browsers and link
// previews, the top menu, the page content, and the footer.
import "@fontsource-variable/instrument-sans";
import "../styles/global.css";
import { getEntry } from "astro:content";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;        // page name, e.g. "About" (leave empty on Home)
  description?: string;  // one sentence about the page
}

const site = (await getEntry("site", "site"))!.data;
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Keeps search engines away until launch (Phase 7 switches this off).
const hideFromSearchEngines = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hideFromSearchEngines && <meta name="robots" content="noindex" />}

    <!-- Link previews (LinkedIn, messages). Preview image added in Phase 6. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
